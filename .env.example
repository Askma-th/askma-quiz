# Supabase Analytics — required for quiz_completions tracking
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Admin dashboard (/admin) — client-side gate (PUBLIC_ prefix required for Astro)
PUBLIC_ADMIN_PASSWORD=choose-a-password

# Server-only (optional; not used by current admin page)
SUPABASE_SERVICE_KEY=your-service-role-key-here
ADMIN_PASSWORD=choose-a-strong-password
