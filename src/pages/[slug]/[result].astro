---
import { getCollection } from 'astro:content';
import BaseLayout from '../../components/BaseLayout.astro';

export async function getStaticPaths() {
  const quizzes = await getCollection('quizzes', ({ data }) => data.isPublished);
  return quizzes.flatMap((quiz) => {
    const slug = quiz.id.replace(/\.json$/, '');
    return quiz.data.resultTypes.map((rt) => ({
      params: { slug, result: rt.key },
      props: { quiz, resultType: rt },
    }));
  });
}

const { quiz, resultType } = Astro.props;
const slug = quiz.id.replace(/\.json$/, '');
const { data } = quiz;

// personality ใน JSON มีเครื่องหมายคำพูดติดมาด้วย — ตัดออกก่อนใช้ใน meta tag
const personality = resultType.personality.replace(/^["“”']+|["“”']+$/g, '').trim();
const firstPara = resultType.description.split('\n\n')[0];
---

<BaseLayout
  title={`${resultType.label} ${resultType.title} — ${data.title}`}
  description={`${personality} — คุณล่ะเป็นแบบไหน? ทำ quiz รู้ผลใน ${data.estimatedMinutes} นาที`}
  ogImage={`/og/${slug}.png`}
  canonicalUrl={`/${slug}/${resultType.key}`}
  accentColor={data.accentColor}
>
  <main class="wrap">
    <p class="eyebrow">เพื่อนของคุณได้ผลลัพธ์นี้</p>

    <div class="card">
      <div class="label">{resultType.label}</div>
      <h1 class="title">{resultType.title}</h1>
      <p class="personality">{personality}</p>
      <p class="desc">{firstPara}</p>

      <ul class="strengths">
        {resultType.strengths.map((s) => <li>{s}</li>)}
      </ul>
    </div>

    <p class="prompt">แล้วคุณล่ะ?</p>
    <a class="cta" href={`/${slug}`}>ทำ quiz นี้เลย →</a>

    <a class="home" href="/">ดู quiz อื่นๆ ทั้งหมด</a>
  </main>
</BaseLayout>

<style>
  .wrap {
    max-width: 560px;
    margin: 0 auto;
    padding: 32px 20px 64px;
    text-align: center;
  }
  .eyebrow {
    color: var(--text-muted);
    font-size: 14px;
    margin: 0 0 16px;
  }
  .card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 28px 20px;
  }
  .label {
    color: var(--accent);
    font-weight: 700;
    letter-spacing: 1px;
    font-size: 14px;
  }
  .title {
    font-size: 30px;
    margin: 10px 0 8px;
  }
  .personality {
    color: var(--accent);
    font-size: 16px;
    margin: 0 0 16px;
  }
  .desc {
    color: var(--text-muted);
    font-size: 15px;
    line-height: 1.7;
    margin: 0 0 20px;
  }
  .strengths {
    list-style: none;
    padding: 0;
    margin: 0;
    text-align: left;
    display: grid;
    gap: 10px;
  }
  .strengths li {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 12px 14px;
    font-size: 14px;
  }
  .prompt {
    margin: 28px 0 12px;
    font-size: 18px;
    font-weight: 600;
  }
  .cta {
    display: block;
    background: var(--accent);
    color: #0a0a14;
    text-decoration: none;
    font-weight: 700;
    font-size: 17px;
    padding: 16px;
    border-radius: 14px;
  }
  .home {
    display: inline-block;
    margin-top: 20px;
    color: var(--text-muted);
    font-size: 14px;
    text-decoration: none;
    border-bottom: 1px solid var(--border);
  }
</style>
