---
import BaseLayout from '../components/BaseLayout.astro';

const adminPassword = import.meta.env.PUBLIC_ADMIN_PASSWORD || '';
---

<BaseLayout
  title="Admin — Askma Quiz"
  description="Quiz analytics dashboard"
  canonicalUrl="/admin"
>
  <div id="gate" style="max-width:420px;margin:80px auto;padding:24px;text-align:center;">
    <h1 style="color:#fff;font-size:24px;margin-bottom:16px;">🔐 Admin</h1>
    <input
      id="pw"
      type="password"
      placeholder="Password"
      style="width:100%;padding:12px;border-radius:10px;border:1px solid #333;background:#1a1a28;color:#fff;font-size:16px;margin-bottom:12px;"
    />
    <button
      id="unlock"
      style="width:100%;padding:12px;border-radius:10px;border:none;background:#FFD600;color:#000;font-weight:700;font-size:16px;cursor:pointer;"
    >
      เข้าสู่ระบบ
    </button>
    <p id="err" style="color:#ef4444;margin-top:12px;display:none;">รหัสผ่านไม่ถูกต้อง</p>
  </div>

  <div id="dashboard" style="display:none;max-width:900px;margin:40px auto;padding:0 16px;">
    <h1 style="color:#fff;font-size:28px;margin-bottom:24px;">📊 Quiz Analytics</h1>

    <div id="overview" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;margin-bottom:32px;"></div>

    <h2 style="color:#fff;font-size:20px;margin-bottom:16px;">แต่ละ Quiz</h2>
    <div id="breakdowns" style="display:flex;flex-direction:column;gap:16px;margin-bottom:32px;"></div>

    <h2 style="color:#fff;font-size:20px;margin-bottom:16px;">กิจกรรมล่าสุด</h2>
    <div id="recent" style="overflow-x:auto;"></div>
  </div>

  <div id="admin-config" data-password={adminPassword} style="display:none;"></div>

  <script>
    import { getAdminOverview, getAllQuizBreakdowns, getRecentCompletions } from '../lib/supabase';

    const adminPassword = document.getElementById('admin-config')?.getAttribute('data-password') || '';

    const gate = document.getElementById('gate');
    const dashboard = document.getElementById('dashboard');
    const pwInput = document.getElementById('pw') as HTMLInputElement;
    const unlockBtn = document.getElementById('unlock');
    const errMsg = document.getElementById('err');

    function tryUnlock() {
      if (pwInput.value === adminPassword && adminPassword !== '') {
        gate!.style.display = 'none';
        dashboard!.style.display = 'block';
        loadDashboard();
      } else {
        errMsg!.style.display = 'block';
      }
    }

    unlockBtn?.addEventListener('click', tryUnlock);
    pwInput?.addEventListener('keydown', (e) => { if (e.key === 'Enter') tryUnlock(); });

    async function loadDashboard() {
      const ov = await getAdminOverview();
      if (ov) {
        document.getElementById('overview')!.innerHTML = [
          card('ทั้งหมด', ov.totalCompletions),
          card('24 ชม.', ov.last24h),
          card('7 วัน', ov.last7d),
          card('จำนวน Quiz', ov.uniqueQuizzes),
        ].join('');
      }

      const bd = await getAllQuizBreakdowns();
      document.getElementById('breakdowns')!.innerHTML = bd.map(q => `
        <div style="background:#1a1a28;border:1px solid #2a2a3a;border-radius:14px;padding:16px;">
          <div style="display:flex;justify-content:space-between;margin-bottom:12px;">
            <strong style="color:#FFD600;font-size:16px;">${q.quizSlug}</strong>
            <span style="color:#a0a0b8;">${q.total} ครั้ง</span>
          </div>
          ${q.results.map(r => `
            <div style="margin-bottom:8px;">
              <div style="display:flex;justify-content:space-between;color:#fff;font-size:13px;margin-bottom:4px;">
                <span>${r.resultKey}</span><span>${r.percentage}% (${r.count})</span>
              </div>
              <div style="height:6px;background:#0a0a12;border-radius:3px;overflow:hidden;">
                <div style="height:6px;width:${r.percentage}%;background:#FFD600;"></div>
              </div>
            </div>
          `).join('')}
        </div>
      `).join('');

      const rc = await getRecentCompletions(30);
      document.getElementById('recent')!.innerHTML = `
        <table style="width:100%;border-collapse:collapse;color:#fff;font-size:13px;">
          <thead>
            <tr style="color:#a0a0b8;text-align:left;border-bottom:1px solid #2a2a3a;">
              <th style="padding:8px;">Quiz</th><th style="padding:8px;">ผล</th>
              <th style="padding:8px;">Referrer</th><th style="padding:8px;">เวลา</th>
            </tr>
          </thead>
          <tbody>
            ${rc.map(r => `
              <tr style="border-bottom:1px solid #1a1a28;">
                <td style="padding:8px;">${r.quizSlug}</td>
                <td style="padding:8px;">${r.resultKey}</td>
                <td style="padding:8px;color:#a0a0b8;">${r.referrer || '-'}</td>
                <td style="padding:8px;color:#a0a0b8;">${new Date(r.createdAt).toLocaleString('th-TH')}</td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      `;
    }

    function card(label: string, value: number) {
      return `
        <div style="background:#1a1a28;border:1px solid #2a2a3a;border-radius:14px;padding:16px;text-align:center;">
          <div style="color:#FFD600;font-size:28px;font-weight:800;">${value}</div>
          <div style="color:#a0a0b8;font-size:12px;margin-top:4px;">${label}</div>
        </div>
      `;
    }
  </script>
</BaseLayout>
